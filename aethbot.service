[Unit]
Description=Aethernf Key Bot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/aethbot
Environment=AETH_BOT_TOKEN=
Environment=AETH_ADMIN_ID=
Environment=AETH_REPO_DIR=/root/aethernf-worker
ExecStart=/usr/bin/python3 /root/aethbot/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
